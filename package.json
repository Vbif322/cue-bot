{
  "name": "cue-bot",
  "version": "1.1.0",
  "description": "",
  "homepage": "https://github.com/Vbif322/cue-bot#readme",
  "bugs": {
    "url": "https://github.com/Vbif322/cue-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vbif322/cue-bot.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "workspaces": [
    "admin",
    "app",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test -c e2e/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "dev": "nodemon",
    "dev:admin": "npm run dev --workspace admin",
    "dev:app": "npm run dev --workspace app",
    "dev:all": "npm run db:up && concurrently --kill-others-on-fail -n api,web,app,db,login -c blue,magenta,cyan,green,blue \"nodemon\" \"node node_modules/vite/bin/vite.js --config admin/vite.config.ts admin --host\" \"node node_modules/vite/bin/vite.js --config app/vite.config.ts app --host\" \"tsx --env-file=.env node_modules/drizzle-kit/bin.cjs studio\" \"sleep 3 && (npm run dev:login || true)\"",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --env-file=.env build/index.js",
    "build:admin": "npm run build --workspace admin",
    "build:app": "npm run build --workspace app",
    "db:up": "docker compose up -d --wait",
    "db:up:wsl": "wsl -d Ubuntu -e bash -c \"docker compose up -d --wait\"",
    "db:down": "docker compose stop",
    "db:down:wsl": "wsl -d Ubuntu -e bash -c \"docker compose stop\"",
    "db:generate": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "seed:de": "tsx --env-file=.env scripts/seed-double-elim.ts",
    "dev:login": "tsx --env-file=.env scripts/dev-login.ts",
    "dev:organizer": "tsx --env-file=.env scripts/dev-organizer.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.41.1",
    "hono": "^4.13.14",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.8.1",
    "testcontainers": "^12.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.7"
  }
}
